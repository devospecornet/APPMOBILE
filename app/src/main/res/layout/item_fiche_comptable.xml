<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/textNumeroComptable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/textUtilisateurComptable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/textMoisComptable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/textMontantComptable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button android:id="@+id/btnValider" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/valider" />
            <Button android:id="@+id/btnRefuser" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/refuser" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
