<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/textNumeroAdminFiche" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/textUtilisateurAdminFiche" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/textMoisAdminFiche" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/textMontantAdminFiche" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/textStatutAdminFiche" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnValiderAdmin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/valider" />
            <Button android:id="@+id/btnRefuserAdmin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/refuser" />
        </LinearLayout>

        <Button android:id="@+id/btnSupprimerFicheAdmin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/supprimer" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
